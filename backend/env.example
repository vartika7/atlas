# Copy to `.env` (`cp env.example .env`) and adjust locally.
# Never commit the real `.env`.
#
# Values here map 1:1 onto `app/core/config.py::Settings`.

ENVIRONMENT=local
DEBUG=true

# JSON array — must be valid JSON because pydantic-settings parses complex types.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Reserved for later sprints -------------------------------------------
# DATABASE_URL=
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# OPENROUTER_API_KEY=
